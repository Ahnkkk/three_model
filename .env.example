# AI 초안 추출(/api/floor-plan/extract) 설정 예시. 실제 값은 .env.local에 두고 커밋하지 않는다.
# 키는 서버에서만 읽고 브라우저로 보내지 않는다. 키가 없는 공급자는 화면에서 고를 수 없다.

# Claude (Anthropic)
ANTHROPIC_API_KEY=
# FLOOR_PLAN_AI_CLAUDE_MODEL=claude-opus-5-5
# FLOOR_PLAN_AI_CLAUDE_EFFORT=high

# GPT (OpenAI)
OPENAI_API_KEY=
# FLOOR_PLAN_AI_OPENAI_MODEL=gpt-6.2-astra
# FLOOR_PLAN_AI_OPENAI_EFFORT=

# 서버 프로세스당 시간당 추출 요청 상한(기본 30)
# FLOOR_PLAN_AI_REQUESTS_PER_HOUR=30

# 개발 전용(production에서는 무시): 모든 공급자가 이 파일 내용을 모델 응답으로 돌려준다(키 없이 화면 흐름 확인).
# 예제 응답은 info.png를 평면도 영역 (300,20)–(900,403)으로 잘라 축소 없이 보냈을 때의 좌표다.
# FLOOR_PLAN_AI_FAKE_FILE=examples/floor-plans/ai/info-extraction.json
